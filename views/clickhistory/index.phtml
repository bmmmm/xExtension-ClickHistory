<?php
	declare(strict_types=1);
	/** @var ClickHistoryView $this */
	// Every link on this page keeps the grouping and the filter the user is under:
	// dropping either halfway through would silently change what they are looking
	// at. array_filter removes whichever of the two is not set.
	$viewParams = array_filter([
		'group' => $this->byCategory ? 'category' : null,
		'status' => $this->status,
	], static fn(?string $value): bool => $value !== null);
	$statusParams = $this->status === null ? [] : ['status' => $this->status];
	$statusLabels = ClickHistoryExtension::statusLabels();
	$rateTitles = ClickHistoryExtension::rateTitles();

	// Before <main>, where the stream views put core's own bar, and outside the
	// empty-history branch below: a page with nothing on it is the one a user most
	// needs a way off of.
	$this->renderHelper('clickhistory/nav');
?>
<main class="post content click-history">
	<h1><?= _t('ext.click_history.title') ?></h1>

	<?php
		// Outside the branch below on purpose: a filter that matches nothing would
		// otherwise be a dead end, with no way of getting back to a state that has
		// rows in it.
		$this->renderHelper('clickhistory/filters');
	?>

	<?php if ($this->history === []) { ?>
		<p class="alert alert-warn"><?= $this->status === null
			? _t('ext.click_history.empty')
			: _t('ext.click_history.empty_filtered') ?></p>
	<?php } else { ?>
		<div class="click-history-toolbar">
			<?php if ($this->byCategory) { ?>
				<a class="btn" href="<?= Minz_Url::display(['c' => 'clickhistory', 'a' => 'index', 'params' => $statusParams]) ?>"><?=
					_t('ext.click_history.group.by_date') ?></a>
			<?php } else { ?>
				<a class="btn" href="<?= Minz_Url::display(['c' => 'clickhistory', 'a' => 'index', 'params' => $statusParams + ['group' => 'category']]) ?>"><?=
					_t('ext.click_history.group.by_category') ?></a>
			<?php } ?>
			<a class="btn" href="<?= Minz_Url::display(['c' => 'clickhistory', 'a' => 'export', 'params' => $viewParams + ['format' => 'json']]) ?>"><?=
				_t('ext.click_history.action.export_json') ?></a>
			<a class="btn" href="<?= Minz_Url::display(['c' => 'clickhistory', 'a' => 'export', 'params' => $viewParams + ['format' => 'csv']]) ?>"><?=
				_t('ext.click_history.action.export_csv') ?></a>
			<?php
				// Carries neither the grouping nor the filter, unlike every other link
				// on this page: the figures are one row per feed over the whole
				// archive, and a filtered version of them would answer a different
				// question — "of the ones I already called good, how many are good".
			?>
			<a class="btn" href="<?= _url('clickhistory', 'stats') ?>"><?= _t('ext.click_history.stats.title') ?></a>
		</div>

		<?php $this->renderHelper('clickhistory/pagination'); ?>

		<div class="table-wrapper scrollbar-thin">
			<table id="click-history-list">
				<thead>
					<tr>
						<th><?= _t('ext.click_history.columns.article') ?></th>
						<th><?= _t('ext.click_history.columns.feed') ?></th>
						<?php if (!$this->byCategory) { ?>
							<th><?= _t('ext.click_history.columns.category') ?></th>
						<?php } ?>
						<th><?= _t('ext.click_history.columns.opened') ?></th>
						<th><?= _t('ext.click_history.columns.actions') ?></th>
					</tr>
				</thead>
				<tbody>
				<?php
					// Grouping is done here rather than in SQL: the rows already
					// arrive sorted by category, so a heading is emitted whenever the
					// name changes. A group that spans a page boundary simply gets its
					// heading again on the next page.
					$currentCategory = null;
					$columnCount = $this->byCategory ? 4 : 5;
					foreach ($this->history as $item) {
						if ($this->byCategory && $item['category_name'] !== $currentCategory) {
							$currentCategory = $item['category_name'];
							?>
							<tr class="click-history-group">
								<th colspan="<?= $columnCount ?>"><?= $currentCategory === ''
									? _t('ext.click_history.no_category')
									: htmlspecialchars($currentCategory, ENT_NOQUOTES, 'UTF-8') ?></th>
							</tr>
							<?php
						}
						// The stored URL came from a feed, and FreshRSS never checks its
						// scheme on the way in. A row whose link is not plain http(s) is
						// still worth showing — it is part of the history — but it is
						// shown as text, because a `javascript:` href one click away is
						// exactly what this page must not become.
						$isWebLink = preg_match('%^https?://%i', $item['url']) === 1;
					?>
					<tr>
						<td class="click-history-title">
							<?php if ($isWebLink) { ?>
								<a target="_blank" rel="noreferrer" href="<?= htmlspecialchars($item['url'], ENT_COMPAT, 'UTF-8') ?>"><?=
									htmlspecialchars($item['title'], ENT_NOQUOTES, 'UTF-8') ?></a>
							<?php } else { ?>
								<?= htmlspecialchars($item['title'], ENT_NOQUOTES, 'UTF-8') ?>
								<code><?= htmlspecialchars($item['url'], ENT_NOQUOTES, 'UTF-8') ?></code>
							<?php } ?>
						</td>
						<td class="click-history-feed"><?= htmlspecialchars($item['feed_name'], ENT_NOQUOTES, 'UTF-8') ?></td>
						<?php if (!$this->byCategory) { ?>
							<td class="click-history-category"><?= $item['category_name'] === ''
								? '<span class="click-history-none">' . _t('ext.click_history.no_category') . '</span>'
								: htmlspecialchars($item['category_name'], ENT_NOQUOTES, 'UTF-8') ?></td>
						<?php } ?>
						<td class="click-history-date">
							<time datetime="<?= timestampToMachineDate($item['clicked_at']) ?>"<?=
								$item['first_clicked_at'] < $item['clicked_at']
									? ' title="' . htmlspecialchars(
										_t('ext.click_history.first_opened', timestamptodate($item['first_clicked_at'])),
										ENT_COMPAT, 'UTF-8'
									) . '"'
									: '' ?>><?= timestamptodate($item['clicked_at']) ?></time>
						</td>
						<td class="click-history-actions">
							<form method="post" action="<?= _url('clickhistory', 'rate') ?>">
								<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
								<input type="hidden" name="id" value="<?= htmlspecialchars($item['id_entry'], ENT_COMPAT, 'UTF-8') ?>" />
								<?php
									// The page the judgement is made on travels along, so the
									// answer can come back to it.
									foreach ($viewParams as $name => $value) {
										echo '<input type="hidden" name="', $name, '" value="',
											htmlspecialchars($value, ENT_COMPAT, 'UTF-8'), '" />';
									}
									if ($this->currentPage > 1) {
										echo '<input type="hidden" name="page" value="', $this->currentPage, '" />';
									}
									// Two buttons rather than three: pressing the state a row is
									// already in takes it back to unrated, which is what a user
									// reaching for the highlighted button means by it.
									foreach ([ClickHistoryDAO::STATUS_GOOD, ClickHistoryDAO::STATUS_DROPPED] as $status) {
										$isCurrent = $item['status'] === $status;
										$title = $isCurrent
											? _t('ext.click_history.rate.undo')
											: $rateTitles[$status];
										// btn-important on top of .active: the rating is what the row
										// says, not merely which control is engaged, so it has to read
										// at a glance. Core's .active alone is a few percent of
										// background lightness in a dark theme — rgb(38,38,38) against
										// rgb(23,23,23), measured — which nobody scanning a table sees.
										// The accent comes from the theme rather than from a colour of
										// our own, and unlike --contrast-background-color (defined in
										// 2 of the 11 bundled themes) this class is in all of them.
										?>
										<button type="submit" name="rate"
											value="<?= $isCurrent ? ClickHistoryDAO::STATUS_UNRATED : $status ?>"
											class="btn<?= $isCurrent ? ' btn-important active' : '' ?>"
											aria-pressed="<?= $isCurrent ? 'true' : 'false' ?>"
											title="<?= htmlspecialchars($title, ENT_COMPAT, 'UTF-8') ?>"><?=
											htmlspecialchars($statusLabels[$status], ENT_NOQUOTES, 'UTF-8') ?></button>
										<?php
									}
								?>
							</form>
							<form method="post" action="<?= _url('clickhistory', 'delete') ?>">
								<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
								<input type="hidden" name="id" value="<?= htmlspecialchars($item['id_entry'], ENT_COMPAT, 'UTF-8') ?>" />
								<button type="submit" class="btn btn-attention confirm"><?= _t('ext.click_history.action.delete') ?></button>
							</form>
						</td>
					</tr>
				<?php } ?>
				</tbody>
			</table>
		</div>

		<?php $this->renderHelper('clickhistory/pagination'); ?>

		<div class="form-group form-actions">
			<div class="group-controls">
				<form method="post" action="<?= _url('clickhistory', 'clear') ?>">
					<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
					<?php
						// The `confirm` class alone: core's init_confirm_action() puts its
						// handler on document.body and then reads `data-str-confirm` with
						// this.getAttribute(), where `this` is the body rather than the
						// button that was clicked (p/scripts/main.js). A wording of our own
						// on this button can therefore never be shown — verified against
						// 1.29.1 — so the generic core message is what users get.
					?>
					<button type="submit" class="btn btn-attention confirm"><?= _t('ext.click_history.action.clear') ?></button>
				</form>
			</div>
		</div>
	<?php } ?>
</main>
