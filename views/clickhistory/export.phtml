<?php
	declare(strict_types=1);
	/** @var ClickHistoryView $this */

	// A feed decides the title, the URL, the feed name and the category name, and a
	// spreadsheet reads a cell starting with one of these as a formula rather than
	// as text — `=HYPERLINK(...)` or `@SUM(...)` in a headline would run when the
	// downloaded file is opened. Prefixing with a single quote is the escape both
	// Excel and LibreOffice understand: the cell stays text and the quote is not
	// part of it. Only the four feed-derived columns need it; the rest are this
	// extension's own values (an id, a status, two timestamps and two dates).
	$csvSafe = static fn(string $value): string =>
		preg_match('/^[=+\-@\t\r]/', $value) === 1 ? "'" . $value : $value;

	// Timestamps are exported twice: the raw Unix value, because that is the one
	// another tool can sort and compare, and an ISO-8601 string, because that is
	// the one a person reading the file can.
	if ($this->exportFormat === 'csv') {
		$out = fopen('php://output', 'w');
		if ($out !== false) {
			// A BOM so that Excel opens the file as UTF-8 instead of guessing a
			// local codepage and mangling every non-ASCII headline.
			fwrite($out, "\xEF\xBB\xBF");
			fputcsv($out, ['id_entry', 'title', 'url', 'feed', 'category', 'status', 'clicked_at', 'clicked_at_iso', 'first_clicked_at', 'first_clicked_at_iso']);
			foreach ($this->history as $item) {
				fputcsv($out, [
					$item['id_entry'],
					$csvSafe($item['title']),
					$csvSafe($item['url']),
					$csvSafe($item['feed_name']),
					$csvSafe($item['category_name']),
					$item['status'],
					$item['clicked_at'],
					date(DATE_ATOM, $item['clicked_at']),
					$item['first_clicked_at'],
					date(DATE_ATOM, $item['first_clicked_at']),
				]);
			}
			fclose($out);
		}
		return;
	}

	$entries = [];
	foreach ($this->history as $item) {
		$entries[] = [
			'id_entry' => $item['id_entry'],
			'title' => $item['title'],
			'url' => $item['url'],
			'feed' => ['id' => $item['id_feed'], 'name' => $item['feed_name']],
			'category' => ['id' => $item['id_category'], 'name' => $item['category_name']],
			'status' => $item['status'],
			'clicked_at' => $item['clicked_at'],
			'clicked_at_iso' => date(DATE_ATOM, $item['clicked_at']),
			'first_clicked_at' => $item['first_clicked_at'],
			'first_clicked_at_iso' => date(DATE_ATOM, $item['first_clicked_at']),
		];
	}

	echo json_encode([
		'generator' => 'xExtension-ClickHistory',
		'exported_at' => date(DATE_ATOM),
		'count' => count($entries),
		'entries' => $entries,
	], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
