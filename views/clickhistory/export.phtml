<?php
	declare(strict_types=1);
	/** @var ClickHistoryView $this */

	// A feed decides the title, the URL, the feed name and the category name, and a
	// spreadsheet reads a cell starting with one of these as a formula rather than
	// as text — `=HYPERLINK(...)` or `@SUM(...)` in a headline would run when the
	// downloaded file is opened. Prefixing with a single quote is the escape both
	// Excel and LibreOffice understand: the cell stays text and the quote is not
	// part of it. Only the four feed-derived columns need it; the rest are this
	// extension's own values (an id, a status, two timestamps and two dates).
	$csvSafe = static fn(string $value): string =>
		preg_match('/^[=+\-@\t\r]/', $value) === 1 ? "'" . $value : $value;

	// Timestamps are exported twice: the raw Unix value, because that is the one
	// another tool can sort and compare, and an ISO-8601 string, because that is
	// the one a person reading the file can.
	if ($this->exportFormat === 'csv') {
		$out = fopen('php://output', 'w');
		if ($out !== false) {
			// A BOM so that Excel opens the file as UTF-8 instead of guessing a
			// local codepage and mangling every non-ASCII headline.
			fwrite($out, "\xEF\xBB\xBF");
			// `escape: ''` on both calls: RFC 4180 has no escape character, only
			// doubled quotes, which is the convention spreadsheet programs follow.
			// PHP's default `\` leaves the quote in a headline's `\"` undoubled, so
			// an RFC 4180 reader ends the cell there (tests/export.php) — and
			// leaving the argument out is deprecated from PHP 8.4 on.
			fputcsv($out, ['id_entry', 'title', 'url', 'feed', 'category', 'status', 'clicked_at', 'clicked_at_iso', 'first_clicked_at', 'first_clicked_at_iso'], escape: '');
			// Straight from the statement to the output stream: this code holds one
			// row at a time and never builds its own copy of the history. (pdo_pgsql
			// still buffers the result set on its side; on MySQL core switches that
			// off — see ClickHistoryDAO::streamAll().)
			foreach ($this->exportRows as $item) {
				fputcsv($out, [
					$item['id_entry'],
					$csvSafe($item['title']),
					$csvSafe($item['url']),
					$csvSafe($item['feed_name']),
					$csvSafe($item['category_name']),
					$item['status'],
					$item['clicked_at'],
					date(DATE_ATOM, $item['clicked_at']),
					$item['first_clicked_at'],
					date(DATE_ATOM, $item['first_clicked_at']),
				], escape: '');
			}
			fclose($out);
		}
		return;
	}

	// JSON is assembled in one piece rather than streamed like the CSV above: a
	// hand-written envelope would have to move `count` after `entries`, and the
	// pretty-printing that makes the file readable is json_encode's, not ours. One
	// copy of the history in memory, where it used to be two.
	$entries = [];
	foreach ($this->exportRows as $item) {
		$entries[] = [
			'id_entry' => $item['id_entry'],
			'title' => $item['title'],
			'url' => $item['url'],
			'feed' => ['id' => $item['id_feed'], 'name' => $item['feed_name']],
			'category' => ['id' => $item['id_category'], 'name' => $item['category_name']],
			'status' => $item['status'],
			'clicked_at' => $item['clicked_at'],
			'clicked_at_iso' => date(DATE_ATOM, $item['clicked_at']),
			'first_clicked_at' => $item['first_clicked_at'],
			'first_clicked_at_iso' => date(DATE_ATOM, $item['first_clicked_at']),
		];
	}

	// JSON_INVALID_UTF8_SUBSTITUTE rather than letting one bad byte lose the lot:
	// the table holds what a feed sent, and a single malformed sequence anywhere in
	// it would otherwise make json_encode() return false and the download arrive
	// empty. The substitution character marks where that happened.
	$json = json_encode([
		'generator' => 'xExtension-ClickHistory',
		'exported_at' => date(DATE_ATOM),
		'count' => count($entries),
		'entries' => $entries,
	], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);

	if ($json === false) {
		// Nothing left to fall back to: the headers went out before this file was
		// reached, so the browser is already saving a .json. Saying so in the log is
		// the difference between "the export is broken" and a reason.
		Minz_Log::error('ClickHistory: cannot encode the export: ' . json_last_error_msg());
		echo '{"error": "encoding failed, see the FreshRSS logs"}';
		return;
	}
	echo $json;
